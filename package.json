{
  "name": "partbypart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PartByPart – portal for 3D building instructions",
  "scripts": {
    "dev": "vite --config _vite/vite.config.ts",
    "build": "tsc --noEmit && vite build --config _vite/vite.config.ts",
    "preview": "vite preview --config _vite/vite.config.ts",
    "test": "node --test app/tests/engine.test.ts instructions/*/model.test.ts",
    "ldraw": "node --experimental-strip-types parts/bricks/build-parts.mjs",
    "check:paths": "node --experimental-strip-types tools/check/entry-paths.mjs",
    "model:t90a": "python3 instructions/nf10330-t90a/build/gen-beams.py && node --experimental-strip-types instructions/nf10330-t90a/build/rotate-beam.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "sass": "^1.80.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=22.18"
  }
}
